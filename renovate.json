{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":dependencyDashboard",
        ":semanticCommits",
        "github>orangecheck/oc-packages:renovate-family"
    ],
    "labels": ["renovate"],
    "prConcurrentLimit": 5,
    "prHourlyLimit": 10,
    "packageRules": [
        {
            "description": "orangecheck on PyPI: its range (>=, <4) already admits each new minor, so an update moves uv.lock, which is what CI and a fork install. Renovate takes a range strategy only in a rule that names no update type.",
            "matchDatasources": ["pypi"],
            "matchPackageNames": ["orangecheck"],
            "rangeStrategy": "update-lockfile"
        },
        {
            "description": "orangecheck on PyPI rides the family bump after the same 1-day window.",
            "matchDatasources": ["pypi"],
            "matchPackageNames": ["orangecheck"],
            "matchUpdateTypes": ["patch", "minor"],
            "enabled": true,
            "groupName": "@orangecheck/* (family)",
            "minimumReleaseAge": "1 day"
        },
        {
            "description": "orangecheck majors on PyPI: a PR of their own, merged by a person, after the same window, as on npm.",
            "matchDatasources": ["pypi"],
            "matchPackageNames": ["orangecheck"],
            "matchUpdateTypes": ["major"],
            "enabled": true,
            "automerge": false,
            "minimumReleaseAge": "1 day",
            "labels": ["renovate", "major-bump"]
        }
    ]
}
