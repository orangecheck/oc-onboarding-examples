# Leave everything empty to run offline: the funnel runs against stand-ins in
# this folder and nothing talks to orangecheck. Fill these in to run it live.
# Every value comes from your project at https://ochk.app/me/projects (free).

# This site's origin, exactly. Sign-in tokens are bound to it.
SITE_ORIGIN=http://localhost:8000

# The project key (Keys & webhooks). Sign in with orangecheck needs it.
OC_PROJECT_KEY=

# The signing secret (Keys & webhooks). With it, and your domain verified, a
# session someone ends everywhere is refused here within about two minutes.
# Leave it empty while you develop on localhost: a project's domain can't be
# localhost, so the list of ended sessions refuses a localhost origin.
# A deployment (APP_ENV=production) refuses to start without it.
OC_SIGNING_SECRET=

# The project's domain token (your project → Domain), served as
# <meta name="oc-domain-verify">. Not a secret. Not needed on localhost.
OC_DOMAIN_VERIFY=

# The Connect API key (Sign-in → Your own login). Shown once; keep it secret.
OCHK_CONNECT_KEY=

# opt-in: an unticked "Also create my orangecheck account" box on sign-up.
# seamless: every sign-up gets an account, identity only (it can't be paid).
CONNECT_MODE=opt-in

# production makes the site refuse to start without its origin and both keys.
APP_ENV=
